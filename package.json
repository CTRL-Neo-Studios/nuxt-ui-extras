{
	"name": "@type32/nuxt-ui-extras",
	"version": "0.1.1",
	"description": "Extra components, composables and filters on top of @nuxt/ui",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CTRL-Neo-Studios/nuxt-ui-extras.git"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepack": "nuxt-module-build build",
		"dev": "bun run dev:prepare && nuxt dev playground",
		"dev:build": "nuxt build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
		"typecheck": "vue-tsc --noEmit",
		"release": "bun run prepack && changelogen --release && npm publish --access public --ignore-scripts && git push --follow-tags"
	},
	"dependencies": {
		"@nuxt/kit": "^4.6.4",
		"@nuxt/ui": "^4.13.0",
		"defu": "^6.1.7",
		"motion-v": "^2.13.0",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@nuxt/fonts": "1.2.0",
		"@nuxt/image": "2.2.1",
		"@nuxt/module-builder": "^1.0.4",
		"@nuxt/schema": "^4.6.4",
		"@types/node": "^26.6.6",
		"@vueuse/nuxt": "15.0.0",
		"changelogen": "^0.6.2",
		"nuxt": "^4.6.4",
		"tailwindcss": "^4.3.5",
		"typescript": "6.0.3",
		"vue": "^3.5.45",
		"vue-tsc": "^3.3.14"
	},
	"peerDependencies": {
		"tailwindcss": "^4"
	},
	"trustedDependencies": [
		"esbuild",
		"vue-demi"
	],
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": ">=22"
	}
}
